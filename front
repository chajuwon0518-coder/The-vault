import os
import random
from fastapi import FastAPI, HTTPException, Depends
from pydantic import BaseModel
from typing import List, Optional
import httpx

app = FastAPI(title="The Vault API")

# --- Mock Database ---
users_db = {}

class User(BaseModel):
    id: int
    name: str
    coins: float = 0.0
    shield_until: Optional[float] = None
    tickets: int = 3
    referrals: int = 0
    lang: str = "en"

# --- AI Provocative Message Engine ---
# 이 함수는 유저의 분노를 유발하여 재접속을 유도하는 심리적 트리거를 생성합니다.
async def generate_provocative_msg(raider_name: str, coins_stolen: int, lang: str):
    prompts = {
        "ko": [
            f"💰 이런! {raider_name}님이 당신의 금고를 털어 {coins_stolen:,}코인을 가져갔습니다! 지금 바로 복수하지 않으면 바보 소리 듣겠는데요?",
            f"🚨 긴급! {raider_name}님이 당신을 '호구'로 찍었습니다. {coins_stolen:,}코인을 뺏기고 가만히 계실 건가요?",
            f"🔥 {raider_name}님이 당신의 코인으로 파티 중입니다. 당장 가서 강탈권을 쓰고 금고를 박살내세요!"
        ],
        "en": [
            f"💰 Ouch! {raider_name} just raided your vault and took {coins_stolen:,} coins! Are you really going to let them get away with this?",
            f"🚨 ALERT! {raider_name} thinks you're an easy target. {coins_stolen:,} coins gone. Go get your revenge NOW!",
            f"🔥 {raider_name} is spending YOUR coins. Use a raid ticket and destroy their vault before they take more!"
        ]
    }
    
    # 실제 운영 시에는 Gemini API 등을 호출하여 더 정교한 '킹받는' 문구를 생성할 수 있습니다.
    # 예: "Gemini API를 사용하여 {raider_name}의 말투를 흉내내어 도발하는 문구 생성"
    msg_list = prompts.get(lang, prompts["en"])
    return random.choice(msg_list)

async def send_telegram_notification(user_id: int, message: str):
    # 텔레그램 봇 API를 통해 유저에게 푸시 알림 전송
    BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
    if not BOT_TOKEN:
        print(f"Notification Mock: To {user_id} - {message}")
        return
    
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
    payload = {"chat_id": user_id, "text": message}
    async with httpx.AsyncClient() as client:
        await client.post(url, json=payload)

# --- Endpoints ---

@app.get("/user/{user_id}", response_model=User)
async def get_user(user_id: int):
    if user_id not in users_db:
        users_db[user_id] = User(id=user_id, name=f"User_{user_id}")
    return users_db[user_id]

@app.post("/raid")
async def raid_vault(attacker_id: int, target_id: int):
    attacker = users_db.get(attacker_id)
    target = users_db.get(target_id)
    
    if not attacker or not target:
        raise HTTPException(status_code=404, detail="User not found")
    
    if attacker.tickets <= 0:
        raise HTTPException(status_code=400, detail="No raid tickets left")
    
    # Shield Check
    import time
    if target.shield_until and target.shield_until > time.time():
        attacker.tickets -= 1
        return {"success": False, "message": "Target is shielded!"}
    
    # Raid Logic (30% 강탈)
    stolen_amount = int(target.coins * 0.3)
    target.coins -= stolen_amount
    attacker.coins += stolen_amount
    attacker.tickets -= 1
    
    # AI 기반 도발 알림 전송 (핵심 수익 엔진)
    provocative_msg = await generate_provocative_msg(attacker.name, stolen_amount, target.lang)
    await send_telegram_notification(target.id, provocative_msg)
    
    return {
        "success": True, 
        "stolen": stolen_amount, 
        "message": f"Successfully raided {stolen_amount} coins!"
    }

# --- Money Extraction Module (Telegram Stars Payments) ---

class InvoiceRequest(BaseModel):
    user_id: int
    item_type: str  # "tickets" or "shield"

@app.post("/create-invoice")
async def create_invoice(req: InvoiceRequest):
    BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
    if not BOT_TOKEN:
        return {"success": False, "message": "Bot token not configured"}

    # 가격 설정 (Stars 단위)
    prices = {
        "tickets": {"amount": 50, "label": "3 Raid Tickets"},
        "shield": {"amount": 100, "label": "24h Shield"}
    }
    
    item = prices.get(req.item_type)
    if not item:
        raise HTTPException(status_code=400, detail="Invalid item type")

    # 텔레그램 결제 API 호출
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/createInvoiceLink"
    payload = {
        "title": item["label"],
        "description": f"Purchase {item['label']} to dominate The Vault!",
        "payload": f"order_{req.item_type}_{req.user_id}",
        "provider_token": "", # Stars 결제 시 비워둠
        "currency": "XTR",     # Telegram Stars 통화 코드
        "prices": [{"label": item["label"], "amount": item["amount"]}]
    }
    
    async with httpx.AsyncClient() as client:
        resp = await client.post(url, json=payload)
        data = resp.json()
        
        if data.get("ok"):
            return {"success": True, "invoice_link": data["result"]}
        else:
            return {"success": False, "error": data.get("description")}

